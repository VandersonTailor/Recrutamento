# ===== App =====
APP_ENV=dev
DATABASE_URL=sqlite:///./backend/data/app.db

# ===== Pastas de currículos =====
# Em produção, use caminho de rede (ex.: V:\DADOS\Treinamento\curriculos_recebidos)
RECV_DIR=V:\DADOS\Treinamento\curriculos_recebidos

# ===== CORS =====
# Exemplo para frontend em dev: 8090
CORS_ORIGINS=["http://127.0.0.1:8090","http://localhost:8090"]

# ===== Autenticação =====
AUTH_USERNAME=recrutamento.carris
AUTH_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_ROLE=admin
AUTH_TOKEN_TTL_MINUTES=480
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
AUTH_COOKIE_NAME=rf_session
AUTH_COOKIE_SECURE=false

# ===== API key opcional =====
API_KEY=

# ===== IA (opcional) =====
AI_PROVIDER=disabled
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Ingestão =====
INGESTION_AUTO_ENABLED=true
INGESTION_AUTO_INTERVAL_MINUTES=60
INGESTION_AUTO_FORCE_REANALYZE=false

# ===== Filas / broker =====
BROKER_ENABLED=false
BROKER_URL=redis://127.0.0.1:6379/0
INGESTION_QUEUE_POLL_SECONDS=5
INGESTION_QUEUE_MAX_RETRIES=3
INGESTION_QUEUE_BACKOFF_SECONDS=15

# ===== Comunicação =====
COMMUNICATION_DISPATCH_ENABLED=true
COMMUNICATION_DISPATCH_POLL_SECONDS=20
COMMUNICATION_DISPATCH_BATCH_SIZE=50
COMMUNICATION_DISPATCH_MAX_RETRIES=3
COMMUNICATION_DISPATCH_BACKOFF_SECONDS=30

# ===== WPPConnect =====
WPPCONNECT_ENABLED=false
WPPCONNECT_BASE_URL=http://127.0.0.1:21465
WPPCONNECT_INSTANCE=
WPPCONNECT_AUTH_TOKEN=
WPPCONNECT_SECRET_KEY=
WPPCONNECT_SEND_PATH=/api/{instance}/send-message
WPPCONNECT_TIMEOUT_SECONDS=20

# ===== E-mail SMTP =====
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# ===== LGPD / Criptografia =====
PII_ENCRYPTION_KEY=
LGPD_RETENTION_AUTO_ENABLED=true
LGPD_RETENTION_INTERVAL_HOURS=24
LGPD_DEFAULT_RETENTION_DAYS=365

# ===== Backup =====
BACKUP_ENABLED=true
BACKUP_DIR=backend/data/backup
BACKUP_INTERVAL_MINUTES=60

